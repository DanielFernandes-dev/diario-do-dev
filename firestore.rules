rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper para verificar se o usuário é admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email.lower() == 'danielfernandesdeoliveira459@gmail.com';
    }

    // Qualquer pessoa (mesmo não autenticada) pode ler os posts.
    // Apenas o admin pode criar, atualizar (conteúdo) ou deletar posts.
    // Qualquer usuário autenticado pode dar like (campos likes/likedBy).
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']));
      allow delete: if isAdmin();

      // Comentários: qualquer um lê.
      // Usuários autenticados podem criar e dar likes (update de likes/likedBy).
      // Edição de conteúdo: somente o autor do comentário.
      // Exclusão: admin (moderação) ou o autor do comentário.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update: if request.auth != null && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'upvotes', 'likedBy'])
          ||
          (
            request.auth.token.email == resource.data.authorId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt'])
          )
        );
        allow delete: if isAdmin() || (request.auth != null && request.auth.token.email == resource.data.authorId);
      }
    }
  }
}
